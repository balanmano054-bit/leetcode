#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Helper function to expand outward from a center pair (left, right)
static int expandAroundCenter(const char* s, int len, int left, int right) {
    while (left >= 0 && right < len && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return length of the palindrome found: (right - 1) - (left + 1) + 1
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || s[0] == '\0') {
        char* empty = (char*)malloc(1 * sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    int len = strlen(s);
    int start = 0; // Starting index of the longest palindrome found
    int maxLen = 0;

    for (int i = 0; i < len; i++) {
        // Odd length palindromes (e.g., "aba" center at i)
        int len1 = expandAroundCenter(s, len, i, i);
        // Even length palindromes (e.g., "abba" center between i and i+1)
        int len2 = expandAroundCenter(s, len, i, i + 1);

        int currentMax = (len1 > len2) ? len1 : len2;

        if (currentMax > maxLen) {
            maxLen = currentMax;
            // Calculate start index based on center i and total length currentMax
            start = i - (currentMax - 1) / 2;
        }
    }

    // Allocate memory for the output substring (+1 for null terminator)
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    strncpy(result, s + start, maxLen);
    result[maxLen] = '\0';

    return result;
}
