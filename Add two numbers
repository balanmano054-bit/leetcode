#include <stdlib.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

struct ListNode* addTwoNumbers(struct ListNode* l1, struct ListNode* l2) {
    struct ListNode dummy; // Dummy head node to simplify list creation
    dummy.next = NULL;
    struct ListNode* tail = &dummy;
    
    int carry = 0;

    // Continue as long as there are digits to add or a leftover carry
    while (l1 != NULL || l2 != NULL || carry != 0) {
        int sum = carry;

        if (l1 != NULL) {
            sum += l1->val;
            l1 = l1->next;
        }
        if (l2 != NULL) {
            sum += l2->val;
            l2 = l2->next;
        }

        carry = sum / 10; // Calculate carry for next step

        // Create new node for current digit (sum % 10)
        struct ListNode* newNode = (struct ListNode*)malloc(sizeof(struct ListNode));
        newNode->val = sum % 10;
        newNode->next = NULL;

        // Append to the result list
        tail->next = newNode;
        tail = newNode;
    }

    return dummy.next;
}
