#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static int min3(int a, int b, int c) {
    int min = a < b ? a : b;
    return min < c ? min : c;
}

int minDistance(char* word1, char* word2) {
    int len1 = strlen(word1);
    int len2 = strlen(word2);

    // Allocate 1D DP array for word2
    int* dp = (int*)malloc((len2 + 1) * sizeof(int));

    // Base case: converting empty word1 to word2[0..j]
    for (int j = 0; j <= len2; j++) {
        dp[j] = j;
    }

    for (int i = 1; i <= len1; i++) {
        int prevDiag = dp[0]; // Stores dp[i-1][j-1]
        dp[0] = i;            // Base case: converting word1[0..i] to empty word2

        for (int j = 1; j <= len2; j++) {
            int temp = dp[j]; // Save dp[i-1][j] before overwriting

            if (word1[i - 1] == word2[j - 1]) {
                dp[j] = prevDiag;
            } else {
                dp[j] = min3(
                    dp[j - 1], // Insert
                    dp[j],     // Delete
                    prevDiag   // Replace
                ) + 1;
            }

            prevDiag = temp; // Move diagonal value rightward
        }
    }

    int result = dp[len2];
    free(dp);
    return result;
}
