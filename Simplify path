#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* simplifyPath(char* path) {
    int len = strlen(path);
    
    // Stack to store directory names
    char** stack = (char**)malloc(len * sizeof(char*));
    int top = 0;

    // Tokenize string by '/'
    char* token = strtok(path, "/");
    while (token != NULL) {
        if (strcmp(token, ".") == 0 || strlen(token) == 0) {
            // Do nothing for '.' or empty tokens
        } else if (strcmp(token, "..") == 0) {
            // Pop from stack if possible
            if (top > 0) {
                top--;
            }
        } else {
            // Push valid directory name onto stack
            stack[top++] = token;
        }
        token = strtok(NULL, "/");
    }

    // Allocate space for canonical path result
    char* result = (char*)malloc((len + 2) * sizeof(char));
    result[0] = '\0';

    if (top == 0) {
        strcpy(result, "/");
    } else {
        for (int i = 0; i < top; i++) {
            strcat(result, "/");
            strcat(result, stack[i]);
        }
    }

    free(stack);
    return result;
}
