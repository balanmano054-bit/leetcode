#include <limits.h>
#include <stdlib.h>

int divide(int dividend, int divisor) {
    // Overflow edge case: INT_MIN / -1 = INT_MAX + 1 (exceeds 32-bit signed int max)
    if (dividend == INT_MIN && divisor == -1) {
        return INT_MAX;
    }

    // Determine the sign of the quotient
    // True if signs differ (one positive, one negative)
    int isNegative = (dividend < 0) ^ (divisor < 0);

    // Convert both numbers to negative long long to avoid INT_MIN overflow when doing abs()
    long long absDividend = llabs((long long)dividend);
    long long absDivisor = llabs((long long)divisor);

    long long quotient = 0;

    // Exponential subtraction using bitwise left shift (doubling divisor)
    while (absDividend >= absDivisor) {
        long long tempDivisor = absDivisor;
        long long multiple = 1;

        // Double the divisor as long as it doesn't exceed absDividend
        while (absDividend >= (tempDivisor << 1)) {
            tempDivisor <<= 1;
            multiple <<= 1;
        }

        absDividend -= tempDivisor;
        quotient += multiple;
    }

    return isNegative ? -quotient : quotient;
}
