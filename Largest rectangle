#include <stdio.h>
#include <stdlib.h>

int largestRectangleArea(int* heights, int heightsSize) {
    if (heightsSize == 0) return 0;

    // Stack stores indices of heights array
    int* stack = (int*)malloc((heightsSize + 1) * sizeof(int));
    int top = -1;
    int maxArea = 0;

    for (int i = 0; i <= heightsSize; i++) {
        // Use height 0 at index heightsSize to flush remaining elements from stack
        int currentHeight = (i == heightsSize) ? 0 : heights[i];

        // Maintain monotonic increasing stack
        while (top >= 0 && currentHeight < heights[stack[top]]) {
            int height = heights[stack[top--]]; // Pop height
            
            // Calculate width: if stack empty, width spans from 0 to i
            int width = (top == -1) ? i : (i - stack[top] - 1);
            
            int area = height * width;
            if (area > maxArea) {
                maxArea = area;
            }
        }

        stack[++top] = i; // Push current index
    }

    free(stack);
    return maxArea;
}
