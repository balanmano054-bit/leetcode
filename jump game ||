int jump(int* nums, int numsSize) {
    if (numsSize <= 1) return 0;

    int jumps = 0;
    int currentEnd = 0;
    int maxReach = 0;

    for (int i = 0; i < numsSize - 1; i++) {
        if (i + nums[i] > maxReach) {
            maxReach = i + nums[i];
        }

        if (i == currentEnd) {
            jumps++;
            currentEnd = maxReach;

            if (currentEnd >= numsSize - 1) {
                break;
            }
        }
    }

    return jumps;
}
