#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int longestValidParentheses(char* s) {
    int len = strlen(s);
    if (len == 0) return 0;

    // Stack to store indices
    int* stack = (int*)malloc((len + 1) * sizeof(int));
    int top = -1;

    // Push initial base boundary index
    stack[++top] = -1;
    int maxLen = 0;

    for (int i = 0; i < len; i++) {
        if (s[i] == '(') {
            stack[++top] = i;
        } else {
            top--; // Pop the matching '(' or previous boundary

            if (top == -1) {
                // If stack becomes empty, push current index as new boundary
                stack[++top] = i;
            } else {
                // Calculate valid length using current index and stack top index
                int currentLen = i - stack[top];
                if (currentLen > maxLen) {
                    maxLen = currentLen;
                }
            }
        }
    }

    free(stack);
    return maxLen;
}
