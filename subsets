#include <stdio.h>
#include <stdlib.h>

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** subsets(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    int totalSubsets = 1 << numsSize; // 2^numsSize

    int** result = (int**)malloc(totalSubsets * sizeof(int*));
    *returnColumnSizes = (int*)malloc(totalSubsets * sizeof(int));
    *returnSize = totalSubsets;

    for (int mask = 0; mask < totalSubsets; mask++) {
        // Count how many elements are included in the current subset (bits set to 1)
        int subsetSize = 0;
        for (int i = 0; i < numsSize; i++) {
            if (mask & (1 << i)) {
                subsetSize++;
            }
        }

        result[mask] = (int*)malloc(subsetSize * sizeof(int));
        (*returnColumnSizes)[mask] = subsetSize;

        // Populate the subset based on set bits
        int index = 0;
        for (int i = 0; i < numsSize; i++) {
            if (mask & (1 << i)) {
                result[mask][index++] = nums[i];
            }
        }
    }

    return result;
}
