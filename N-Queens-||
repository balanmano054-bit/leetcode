#include <stdio.h>

static void backtrack(int row, int n, int cols, int diag1, int diag2, int* count) {
    if (row == n) {
        (*count)++;
        return;
    }

    // Full bitmask of available positions in an N-wide row
    int fullMask = (1 << n) - 1;

    // Get all valid positions for the current row (0 means occupied/under attack, 1 means free)
    int availablePositions = fullMask & ~(cols | diag1 | diag2);

    while (availablePositions > 0) {
        // Extract the lowest set bit (rightmost valid column)
        int p = availablePositions & -availablePositions;

        // Clear the lowest set bit
        availablePositions -= p;

        // Recurse to next row:
        // - cols | p: column is now occupied
        // - (diag1 | p) << 1: main diagonal shifts left for the next row
        // - (diag2 | p) >> 1: anti-diagonal shifts right for the next row
        backtrack(row + 1, n, cols | p, (diag1 | p) << 1, (diag2 | p) >> 1, count);
    }
}

int totalNQueens(int n) {
    int count = 0;
    backtrack(0, n, 0, 0, 0, &count);
    return count;
}
