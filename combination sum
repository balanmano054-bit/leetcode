#include <stdio.h>
#include <stdlib.h>

static void backtrack(int* candidates, int candidatesSize, int target, int start, 
                      int* currentComb, int currentSize, 
                      int*** result, int* resultSize, int** columnSizes, int* capacity) {
    // Base case: target met
    if (target == 0) {
        if (*resultSize >= *capacity) {
            *capacity *= 2;
            *result = (int**)realloc(*result, (*capacity) * sizeof(int*));
            *columnSizes = (int*)realloc(*columnSizes, (*capacity) * sizeof(int));
        }
        
        // Copy current combination into result
        (*result)[*resultSize] = (int*)malloc(currentSize * sizeof(int));
        for (int i = 0; i < currentSize; i++) {
            (*result)[*resultSize][i] = currentComb[i];
        }
        (*columnSizes)[*resultSize] = currentSize;
        (*resultSize)++;
        return;
    }

    for (int i = start; i < candidatesSize; i++) {
        // If current candidate exceeds target, skip
        if (candidates[i] <= target) {
            // Choose candidate
            currentComb[currentSize] = candidates[i];
            
            // Recurse with same index 'i' (allows reuse)
            backtrack(candidates, candidatesSize, target - candidates[i], i, 
                      currentComb, currentSize + 1, 
                      result, resultSize, columnSizes, capacity);
        }
    }
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** combinationSum(int* candidates, int candidatesSize, int target, int* returnSize, int** returnColumnSizes) {
    int capacity = 100;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));
    *returnSize = 0;

    // Temporary array to store current path/combination (max target elements if candidate is 1)
    int* currentComb = (int*)malloc((target + 1) * sizeof(int));

    backtrack(candidates, candidatesSize, target, 0, 
              currentComb, 0, 
              &result, returnSize, returnColumnSizes, &capacity);

    free(currentComb);
    return result;
}
