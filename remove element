int removeElement(int* nums, int numsSize, int val) {
    int k = 0; // Pointer for storing valid elements

    for (int i = 0; i < numsSize; i++) {
        // If current element is not the target value to remove
        if (nums[i] != val) {
            nums[k] = nums[i];
            k++;
        }
    }

    return k;
}
