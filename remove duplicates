int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) {
        return 0;
    }

    // Pointer for position of the next unique element
    int k = 1;

    for (int i = 1; i < numsSize; i++) {
        // When a new unique element is found
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i];
            k++;
        }
    }

    return k;
}
