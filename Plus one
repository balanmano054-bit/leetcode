#include <stdio.h>
#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* plusOne(int* digits, int digitsSize, int* returnSize) {
    // Traverse from least significant digit to most significant
    for (int i = digitsSize - 1; i >= 0; i--) {
        if (digits[i] < 9) {
            digits[i]++;
            
            // Allocate memory for output and copy updated array
            int* result = (int*)malloc(digitsSize * sizeof(int));
            for (int j = 0; j < digitsSize; j++) {
                result[j] = digits[j];
            }
            *returnSize = digitsSize;
            return result;
        }
        
        // Digit is 9, so set to 0 and carry over 1
        digits[i] = 0;
    }

    // If all digits were 9, we need an extra digit (e.g., [9,9] -> [1,0,0])
    *returnSize = digitsSize + 1;
    int* result = (int*)calloc(*returnSize, sizeof(int));
    result[0] = 1; // First digit becomes 1, remaining are 0

    return result;
}
