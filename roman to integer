#include <string.h>

// Helper function to map a Roman character to its integer value
static int getValue(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int len = strlen(s);

    for (int i = 0; i < len; i++) {
        int currentVal = getValue(s[i]);
        int nextVal = (i + 1 < len) ? getValue(s[i + 1]) : 0;

        // Subtractive rule: if current value is less than next value, subtract it
        if (currentVal < nextVal) {
            total -= currentVal;
        } else {
            total += currentVal;
        }
    }

    return total;
}
