#include <stdio.h>
#include <stdlib.h>

// Helper function: Solves Largest Rectangle in Histogram (LeetCode 84) in O(cols)
static int maxHistogramArea(int* heights, int cols, int* stack) {
    int top = -1;
    int maxArea = 0;

    for (int i = 0; i <= cols; i++) {
        int currentHeight = (i == cols) ? 0 : heights[i];

        while (top >= 0 && currentHeight < heights[stack[top]]) {
            int h = heights[stack[top--]];
            int w = (top == -1) ? i : (i - stack[top] - 1);
            int area = h * w;
            if (area > maxArea) {
                maxArea = area;
            }
        }

        stack[++top] = i;
    }

    return maxArea;
}

int maximalRectangle(char** matrix, int matrixSize, int* matrixColSize) {
    if (matrixSize == 0 || matrixColSize[0] == 0) return 0;

    int rows = matrixSize;
    int cols = matrixColSize[0];

    int* heights = (int*)calloc(cols, sizeof(int));
    int* stack = (int*)malloc((cols + 1) * sizeof(int));
    int maxArea = 0;

    for (int r = 0; r < rows; r++) {
        // Update histogram heights for current row
        for (int c = 0; c < cols; c++) {
            if (matrix[r][c] == '1') {
                heights[c]++;
            } else {
                heights[c] = 0;
            }
        }

        // Calculate max area for current row's histogram
        int area = maxHistogramArea(heights, cols, stack);
        if (area > maxArea) {
            maxArea = area;
        }
    }

    free(heights);
    free(stack);

    return maxArea;
}
