#include <stdlib.h>
#include <stdbool.h>

// Helper function to find bound (findFirst = true for leftmost, false for rightmost)
static int findBound(int* nums, int numsSize, int target, bool findFirst) {
    int left = 0;
    int right = numsSize - 1;
    int bound = -1;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (nums[mid] == target) {
            bound = mid; // Store candidate index
            if (findFirst) {
                right = mid - 1; // Narrow down left side
            } else {
                left = mid + 1;  // Narrow down right side
            }
        } else if (nums[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }

    return bound;
}

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* searchRange(int* nums, int numsSize, int target, int* returnSize) {
    *returnSize = 2;
    int* result = (int*)malloc(2 * sizeof(int));

    result[0] = findBound(nums, numsSize, target, true);  // First occurrence
    result[1] = findBound(nums, numsSize, target, false); // Last occurrence

    return result;
}
