#include <stdbool.h>
#include <ctype.h>

bool isNumber(char* s) {
    bool seenDigit = false;
    bool seenDot = false;
    bool seenExponent = false;

    for (int i = 0; s[i] != '\0'; i++) {
        char ch = s[i];

        if (isdigit(ch)) {
            seenDigit = true;
        } 
        else if (ch == '+' || ch == '-') {
            // Sign is valid only at index 0 or immediately after 'e' / 'E'
            if (i > 0 && s[i - 1] != 'e' && s[i - 1] != 'E') {
                return false;
            }
        } 
        else if (ch == '.') {
            // Dot is invalid if we have already seen a dot or an exponent
            if (seenDot || seenExponent) {
                return false;
            }
            seenDot = true;
        } 
        else if (ch == 'e' || ch == 'E') {
            // Exponent is invalid if we haven't seen a digit yet or already saw an exponent
            if (seenExponent || !seenDigit) {
                return false;
            }
            seenExponent = true;
            seenDigit = false; // Must be followed by a new integer
        } 
        else {
            // Any other character is invalid
            return false;
        }
    }

    // A valid number must end after encountering at least one digit
    return seenDigit;
}
