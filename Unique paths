#include <stdio.h>
#include <stdlib.h>

int uniquePaths(int m, int n) {
    // 1D DP array of size n, initialized to 1s
    int* dp = (int*)malloc(n * sizeof(int));
    for (int j = 0; j < n; j++) {
        dp[j] = 1;
    }

    // Process row by row
    for (int i = 1; i < m; i++) {
        for (int j = 1; j < n; j++) {
            dp[j] += dp[j - 1];
        }
    }

    int result = dp[n - 1];
    free(dp);
    return result;
}
